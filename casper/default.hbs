<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Dark"}} class="dark-mode"{{else match @custom.color_scheme "Auto"}} class="auto-color"{{/match}}>
<head>

    {{!-- Basic meta - advanced meta is output with {ghost_head} below --}}
    <title>{{meta_title}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    {{!-- Press Start 2P pixel font --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

    {{!-- Preload scripts --}}
    <link rel="preload" as="style" href="{{asset "built/screen.css"}}" />
    <link rel="preload" as="script" href="{{asset "built/casper.js"}}" />

    {{!-- Theme assets - use the {asset} helper to reference styles & scripts,
    this will take care of caching and cache-busting automatically --}}
    <link rel="stylesheet" type="text/css" href="{{asset "built/screen.css"}}" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/custom.css"}}" />

    {{!-- Inject Ghost Admin design settings as CSS custom properties.
         ghost_head runs after this and sets --ghost-accent-color from Brand settings. --}}
    <style>
        :root {
            --theme:    {{@custom.theme_bg_color}};
            --theme-lt: {{@custom.theme_bg_color}};
            --text:     {{@custom.theme_text_color}};
            --hero-bg:  {{@custom.hero_bg_color}};
        }
    </style>

    {{!-- This tag outputs all your advanced SEO meta, structured data, and other important settings,
    it should always be the last tag before the closing head tag --}}
    {{ghost_head}}

</head>
<body class="{{body_class}} is-head-{{#match @custom.navigation_layout "Logo on cover"}}left-logo{{else match @custom.navigation_layout "Logo in the middle"}}middle-logo{{else}}stacked{{/match}}{{#match @custom.title_font "=" "Elegant serif"}} has-serif-title{{/match}}{{#match @custom.body_font "=" "Modern sans-serif"}} has-sans-body{{/match}}{{#if @custom.show_publication_cover}} has-cover{{/if}}">

    {{!-- Full-page gate: hidden once the home page's active hero video can
    play (or after a timeout, so a slow/broken connection never traps the
    visitor here). See the script near the end of this file. --}}
    {{#is "home"}}
    <div class="page-loader" id="page-loader" aria-hidden="true"></div>
    {{/is}}

<div class="viewport">

    {{!-- Fixed video background for post pages in portrait orientation.
    No src up front — only loaded if/when the page is actually viewed in
    portrait, since it's always hidden in landscape anyway. --}}
    <video class="post-bg-video"
           data-src="{{asset "images/wall_vertical.webm"}}"
           autoplay loop muted playsinline preload="none"
           aria-hidden="true"
    ></video>
    <div class="post-bg-overlay"></div>

    <header id="gh-head" class="gh-head outer{{#match @custom.header_style "Hidden"}} is-header-hidden{{/match}}">
        <div class="gh-head-inner">
            <div class="gh-head-brand">
                <a class="gh-head-logo{{#unless @site.logo}} no-image{{/unless}}" href="{{@site.url}}">
                    {{#if @site.logo}}
                        <img src="{{@site.logo}}" alt="{{@site.title}}">
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </a>
                <button class="gh-search gh-icon-btn" aria-label="Search this site" data-ghost-search>{{> "icons/search"}}</button>
                <button class="gh-burger" aria-label="Main Menu">{{> "icons/bars"}}</button>
            </div>

            <nav class="gh-head-menu">
                {{navigation}}
                {{#unless @site.members_enabled}}
                    {{#match @custom.navigation_layout "Stacked"}}
                        <button class="gh-search gh-icon-btn" aria-label="Search this site" data-ghost-search>{{> "icons/search"}}</button>
                    {{/match}}
                {{/unless}}
            </nav>

            <div class="gh-head-actions">
                {{#unless @site.members_enabled}}
                    {{^match @custom.navigation_layout "Stacked"}}
                        <button class="gh-search gh-icon-btn" aria-label="Search this site" data-ghost-search>{{> "icons/search"}}</button>
                    {{/match}}
                {{else}}
                    <button class="gh-search gh-icon-btn" aria-label="Search this site" data-ghost-search>{{> "icons/search"}}</button>
                    <div class="gh-head-members">
                        {{#unless @member}}
                            {{#unless @site.members_invite_only}}
                                <a class="gh-head-link" href="#/portal/signin" data-portal="signin">Sign in</a>
                                <a class="gh-head-button" href="#/portal/signup" data-portal="signup">Subscribe</a>
                            {{else}}
                                <a class="gh-head-button" href="#/portal/signin" data-portal="signin">Sign in</a>
                            {{/unless}}
                        {{else}}
                            <a class="gh-head-button" href="#/portal/account" data-portal="account">Account</a>
                        {{/unless}}
                    </div>
                {{/unless}}
            </div>
        </div>
    </header>

    <div class="site-content">
        {{!-- All other templates get inserted here, index.hbs, post.hbs, etc --}}
        {{{body}}}
    </div>

    {{!-- The global footer at the very bottom of the screen --}}
    <footer class="site-footer outer">
        <div class="inner">
            <section class="copyright"><a href="{{@site.url}}">{{@site.title}}</a> &copy; {{date format="YYYY"}}</section>
            <nav class="site-footer-nav">
                {{navigation type="secondary"}}
            </nav>
            <div class="gh-powered-by"><a href="https://ghost.org/" target="_blank" rel="noopener">Powered by Ghost</a></div>
        </div>
    </footer>

</div>
{{!-- /.viewport --}}

{{#is "post, page"}}
    {{> "lightbox"}}
{{/is}}

{{!-- Scripts - handle member signups, responsive videos, infinite scroll, floating headers, and galleries.
Both deferred so they don't block initial rendering. defer preserves relative document order between
external scripts, so jQuery still finishes before casper.js (which bundles the FitVids jQuery plugin
and needs $ to already exist) — but the inline script below can't rely on that timing implicitly, since
non-deferred inline scripts still run immediately, before deferred scripts have executed. The
$(document).ready(...) call is wrapped in DOMContentLoaded to guarantee $ actually exists by then
(DOMContentLoaded only fires after all defer scripts finish). --}}
<script
    src="https://code.jquery.com/jquery-3.5.1.min.js"
    integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
    crossorigin="anonymous"
    defer>
</script>
<script src="{{asset "built/casper.js"}}" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    $(document).ready(function () {
        // Mobile Menu Trigger
        $('.gh-burger').click(function () {
            $('body').toggleClass('gh-head-open');
        });
        // FitVids - Makes video embeds responsive
        $(".gh-content").fitVids();
    });
});

// Ensure background videos autoplay on mobile after reload or BFCache restore
(function () {
    function playAllVideos() {
        document.querySelectorAll('video[autoplay]').forEach(function (v) {
            // v.src may still be unset if this orientation's video hasn't
            // been lazy-loaded yet (see the block below) — nothing to play.
            if (v.src && v.paused) {
                v.play().catch(function () {});
            }
        });
    }

    // BFCache restore (back/forward navigation or reload from cache)
    window.addEventListener('pageshow', function (e) {
        if (e.persisted) {
            playAllVideos();
        }
    });

    // Tab becomes visible again
    document.addEventListener('visibilitychange', function () {
        if (!document.hidden) {
            playAllVideos();
        }
    });

    // Initial load fallback in case autoplay attribute alone wasn't enough
    window.addEventListener('load', playAllVideos);
}());

// Orientation-aware lazy video loading + a full-page loader gate on the
// home page + per-thumbnail loading indicators for lazy post card images.
(function () {
    var PAGE_LOADER_TIMEOUT_MS = 8000;

    var landscapeVideo = document.querySelector('.hero-bg-landscape');
    var portraitVideo  = document.querySelector('.hero-bg-portrait');
    var postBgVideo    = document.querySelector('.post-bg-video');
    var orientationQuery = window.matchMedia('(orientation: portrait)');

    function loadVideo(video) {
        if (!video || video.getAttribute('src')) return; // already loaded, or not on this page
        var src = video.getAttribute('data-src');
        if (!src) return;
        video.src = src;
        video.load();
    }

    function activeHeroVideo() {
        return orientationQuery.matches ? portraitVideo : landscapeVideo;
    }

    // Only fetch whichever video the current orientation actually shows.
    // post-bg-video is portrait-only (see custom.css), so it loads with
    // the portrait hero rather than always, or never in landscape.
    function syncVideosToOrientation() {
        if (orientationQuery.matches) {
            loadVideo(portraitVideo);
            loadVideo(postBgVideo);
        } else {
            loadVideo(landscapeVideo);
        }
    }
    syncVideosToOrientation();

    // If the visitor actually rotates/resizes into the other orientation,
    // load that video then — never both up front.
    if (orientationQuery.addEventListener) {
        orientationQuery.addEventListener('change', syncVideosToOrientation);
    } else if (orientationQuery.addListener) {
        orientationQuery.addListener(syncVideosToOrientation); // older Safari
    }

    // Full-page loader (home template only): stay up until the active
    // hero video can play, or the timeout fires — whichever comes first.
    var pageLoader = document.getElementById('page-loader');
    if (pageLoader) {
        var revealed = false;
        function revealPage() {
            if (revealed) return;
            revealed = true;
            pageLoader.classList.add('is-hidden');
        }
        var hero = activeHeroVideo();
        if (hero) {
            hero.addEventListener('canplay', revealPage, { once: true });
            hero.addEventListener('error', revealPage, { once: true });
        } else {
            revealPage();
        }
        setTimeout(revealPage, PAGE_LOADER_TIMEOUT_MS);
    }

    // Per-thumbnail loading indicator for lazy-loaded post card images.
    document.querySelectorAll('.post-card-image-link').forEach(function (link) {
        var img = link.querySelector('.post-card-image');
        if (!img) return;
        if (img.complete && img.naturalWidth > 0) return; // already loaded (cache)
        link.classList.add('is-loading');
        function stopLoading() {
            link.classList.remove('is-loading');
        }
        img.addEventListener('load', stopLoading, { once: true });
        img.addEventListener('error', stopLoading, { once: true });
    });
}());
</script>

{{!-- Ghost outputs required functional scripts with this tag - it should always be the last thing before the closing body tag --}}
{{ghost_foot}}

</body>
</html>
